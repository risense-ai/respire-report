{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentNotify",
  "version": "0.1.0",
  "identifier": "app.agentnotify.desktop",
  "build": { "beforeDevCommand": "pnpm dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "pnpm build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "AgentNotify", "width": 1060, "height": 720, "minWidth": 740, "minHeight": 540, "label": "main" }], "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" } },
  "bundle": { "active": false, "targets": "all" }
}
